#: includes/emails/class-hpve-listing-verification-expire.php:35
msgid "Listing Verification Expired"
msgstr ""

#: includes/emails/class-hpve-listing-verification-expire.php:36
msgid "This email is sent to the owner of a listing when the listing's verified badge is removed because its expiry date has passed."
msgstr ""

#: includes/emails/class-hpve-listing-verification-expire.php:54
msgid "Your listing verification has expired"
msgstr ""

#. translators: 1: the owner's name, 2: the listing title, 3: the expiry date, 4: the link to the listing. All four are filled in automatically.
#: includes/emails/class-hpve-listing-verification-expire.php:59
#, php-format
msgid "Hi, %1$s! The verification of your listing \"%2$s\" was due for review on %3$s and has now ended, so the verified badge no longer shows on it. Please check that the listing and your contact details are still up to date, then get in touch with us to have it verified again: %4$s"
msgstr ""

#: includes/emails/class-hpve-listing-verification-remind.php:35
msgid "Listing Verification Expiring"
msgstr ""

#: includes/emails/class-hpve-listing-verification-remind.php:36
msgid "This email is sent to the owner of a listing a set number of days before the listing's verified badge is due to be removed. The number of days is set under HivePress > Settings > Verification Expiry."
msgstr ""

#: includes/emails/class-hpve-listing-verification-remind.php:54
msgid "Your listing verification is due for review"
msgstr ""

#. translators: 1: the owner's name, 2: the listing title, 3: the expiry date, 4: the link to the listing. All four are filled in automatically.
#: includes/emails/class-hpve-listing-verification-remind.php:59
#, php-format
msgid "Hi, %1$s! The verification of your listing \"%2$s\" is due for review on %3$s. Please make sure the listing and your contact details are up to date before then, so it can be renewed: %4$s"
msgstr ""

#: includes/emails/class-hpve-listing-verification-verified.php:35
msgid "Listing Verified"
msgstr ""

#: includes/emails/class-hpve-listing-verification-verified.php:36
msgid "This email is sent to the owner of a listing when the listing is marked as verified. It can be switched off under HivePress > Settings > Verification Expiry."
msgstr ""

#: includes/emails/class-hpve-listing-verification-verified.php:54
msgid "Your listing is now verified"
msgstr ""

#. translators: 1: the owner's name, 2: the listing title, 3: a sentence about the review date, or nothing, 4: the link to the listing. All four are filled in automatically.
#: includes/emails/class-hpve-listing-verification-verified.php:61
#, php-format
msgid "Hi, %1$s! Your listing \"%2$s\" has been verified, and the verified badge now shows on it. %3$sYou can see it here: %4$s"
msgstr ""

#: includes/emails/class-hpve-vendor-verification-expire.php:42
msgid "Vendor Verification Expired"
msgstr ""

#: includes/emails/class-hpve-vendor-verification-expire.php:43
msgid "This email is sent to a vendor when their verified status is removed because its expiry date has passed."
msgstr ""

#: includes/emails/class-hpve-vendor-verification-expire.php:61
msgid "Your verified status has expired"
msgstr ""

#. translators: 1: the vendor's name, 2: their profile name, 3: the expiry date, 4: the link to their profile. All four are filled in automatically.
#: includes/emails/class-hpve-vendor-verification-expire.php:75
#, php-format
msgid "Hi, %1$s! Your verified status for \"%2$s\" was due for review on %3$s and has now been removed, so the verified badge no longer shows for you on the site. Please check that your profile, listings and contact details are still up to date, then get in touch with us to be verified again: %4$s"
msgstr ""

#: includes/emails/class-hpve-vendor-verification-remind.php:35
msgid "Vendor Verification Expiring"
msgstr ""

#: includes/emails/class-hpve-vendor-verification-remind.php:36
msgid "This email is sent to a vendor a set number of days before their verified status ends. The number of days is set under HivePress > Settings > Verification Expiry."
msgstr ""

#: includes/emails/class-hpve-vendor-verification-remind.php:54
msgid "Your verified status is due for review"
msgstr ""

#. translators: 1: the vendor's name, 2: their profile name, 3: the expiry date, 4: the link to their profile. All four are filled in automatically.
#: includes/emails/class-hpve-vendor-verification-remind.php:60
#, php-format
msgid "Hi, %1$s! Your verified status for \"%2$s\" is due for review on %3$s. Please make sure your profile, listings and contact details are up to date before then, so it can be renewed: %4$s"
msgstr ""

#: includes/emails/class-hpve-vendor-verification-verified.php:35
msgid "Vendor Verified"
msgstr ""

#: includes/emails/class-hpve-vendor-verification-verified.php:36
msgid "This email is sent to a vendor when they are marked as verified. It can be switched off under HivePress > Settings > Verification Expiry."
msgstr ""

#: includes/emails/class-hpve-vendor-verification-verified.php:54
msgid "You are now verified"
msgstr ""

#. translators: 1: the vendor's name, 2: their profile name, 3: "your profile" or "your profile and listings", 4: a sentence about the review date, or nothing, 5: the link to their profile. All five are filled in automatically.
#: includes/emails/class-hpve-vendor-verification-verified.php:63
