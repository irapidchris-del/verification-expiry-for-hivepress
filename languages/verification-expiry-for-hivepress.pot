#: includes/emails/class-hpve-vendor-verification-expire.php:42
msgid "Vendor Verification Expired"
msgstr ""

#: includes/emails/class-hpve-vendor-verification-expire.php:43
msgid "This email is sent to a vendor when their verified status is removed because its expiry date has passed."
msgstr ""

#: includes/emails/class-hpve-vendor-verification-expire.php:61
msgid "Your verified status has expired"
msgstr ""

#. translators: 1: the vendor's name, 2: their profile name, 3: the expiry date, 4: the link to their profile. All four are filled in automatically.
#: includes/emails/class-hpve-vendor-verification-expire.php:75
#, php-format
msgid "Hi, %1$s! The verified badge on your profile \"%2$s\" was due for review on %3$s and has now been removed. Please check that your profile, listings and contact details are still up to date, then get in touch with us to be verified again: %4$s"
msgstr ""

#: includes/emails/class-hpve-vendor-verification-remind.php:35
msgid "Vendor Verification Expiring"
msgstr ""

#: includes/emails/class-hpve-vendor-verification-remind.php:36
msgid "This email is sent to a vendor a set number of days before their verified status ends. The number of days is set under HivePress > Settings > Verification Expiry."
msgstr ""

#: includes/emails/class-hpve-vendor-verification-remind.php:54
msgid "Your verified status is due for review"
msgstr ""

#. translators: 1: the vendor's name, 2: their profile name, 3: the expiry date, 4: the link to their profile. All four are filled in automatically.
#: includes/emails/class-hpve-vendor-verification-remind.php:60
#, php-format
msgid "Hi, %1$s! The verified badge on your profile \"%2$s\" is due for review on %3$s. Please make sure your profile, listings and contact details are up to date before then, so it can be renewed: %4$s"
msgstr ""

